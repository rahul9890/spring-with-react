<configuration>

    <!-- Register your custom converter -->
    <conversionRule conversionWord="orderedMDC" converterClass="com.example.spring_with_react.configs.OrderedMDCConverter"/>

    <!-- Updated pattern -->
    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{2} - %orderedMDC - %msg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

</configuration>
